{
  "name": "enmascara-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "check": "biome check --write .",
    "lint": "biome ci .",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "pnpm build && vitest run",
    "coverage": "pnpm build && vitest run --coverage",
    "mutation": "pnpm build && stryker run",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@changesets/cli": "3.0.3",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "tsup": "9.0.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
