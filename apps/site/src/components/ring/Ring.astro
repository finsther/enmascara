---
import { codeSnippet } from '../../ring/code-snippet.ts';
import { RING_EXAMPLES } from '../../ring/examples.ts';
import {
  IDENTIFIER_TYPES,
  identifierLabel,
} from '../../ring/identifier-labels.ts';
import {
  inputSizeLabel,
  maskedCountLabel,
  maskedDataLabel,
  RING_STRATEGIES,
  settingsSummary,
  strategyLabel,
} from '../../ring/ring-copy.ts';
import {
  DEFAULT_RING_OPTIONS,
  type RingStrategy,
} from '../../ring/ring-options.ts';
import { runRing } from '../../ring/run-ring.ts';

interface Props {
  readonly variant: 'full' | 'compact';
}

const COMPACT_STRATEGIES: readonly RingStrategy[] = ['halfMask', 'fullMask'];

const { variant } = Astro.props;
const isFull = variant === 'full';
const prefix = `ring-${variant}`;
const hydration = isFull ? 'load' : 'visible';
const strategies = isFull ? RING_STRATEGIES : COMPACT_STRATEGIES;
const initialInput = RING_EXAMPLES[0]?.text ?? '';
const initial = runRing(initialInput, DEFAULT_RING_OPTIONS);
const summary = isFull
  ? maskedCountLabel(initial.rows.length)
  : maskedDataLabel(initial.rows.length);
---

{
  isFull ? (
    <section
      class="ring ring--full"
      aria-label="El ring"
      data-ring
      data-ring-hydration={hydration}
      data-ring-variant={variant}
    >
      <div class="ring-toolbar">
        <fieldset class="ring-group ring-examples">
          <legend class="ring-overline">Cargar ejemplo</legend>
          <div class="ring-choices ring-examples-row">
            {RING_EXAMPLES.map(({ id, label }) => (
              <button type="button" class="ring-chip" data-ring-example={id}>
                {label}
              </button>
            ))}
          </div>
        </fieldset>

        <div class="ring-settings-card">
          <button
            type="button"
            class="ring-settings-toggle"
            aria-expanded="false"
            aria-controls={`${prefix}-settings`}
            data-ring-settings-toggle
          >
            <span class="ring-settings-text">
              <span class="ring-settings-title">Ajustes</span>
              <span class="ring-settings-summary" data-ring-settings-summary>
                {settingsSummary(DEFAULT_RING_OPTIONS)}
              </span>
            </span>
            <svg
              class="ring-chevron"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m6 9 6 6 6-6" />
            </svg>
          </button>
          <div
            id={`${prefix}-settings`}
            class="ring-settings"
            data-collapsed
            data-ring-settings
          >
            <fieldset class="ring-group ring-types">
              <legend class="ring-overline">Detectar</legend>
              <div class="ring-choices ring-types-grid">
                {IDENTIFIER_TYPES.map((type) => (
                  <label class="ring-chip ring-check">
                    <input
                      type="checkbox"
                      name={`${prefix}-detect`}
                      value={type}
                      checked={DEFAULT_RING_OPTIONS.detect.includes(type)}
                      data-ring-type
                    />
                    {identifierLabel(type)}
                  </label>
                ))}
              </div>
            </fieldset>
            <fieldset class="ring-group ring-strategies">
              <legend class="ring-overline">Estrategia</legend>
              <div class="ring-choices ring-strategy-list">
                {strategies.map((strategy) => (
                  <button
                    type="button"
                    class="ring-strategy"
                    aria-pressed={strategy === DEFAULT_RING_OPTIONS.strategy}
                    data-ring-strategy={strategy}
                  >
                    {strategyLabel(strategy)}
                  </button>
                ))}
              </div>
            </fieldset>
          </div>
        </div>
      </div>

      <div class="ring-panels">
        <div class="ring-panel">
          <div class="ring-panel-head">
            <label class="ring-panel-title" for={`${prefix}-input`}>
              Entrada
            </label>
            <span class="ring-panel-meta" data-ring-input-size>
              {inputSizeLabel(initialInput.length)}
            </span>
          </div>
          <textarea
            id={`${prefix}-input`}
            class="ring-input"
            spellcheck="false"
            autocomplete="off"
            autocapitalize="off"
            data-ring-input
          >{initialInput}</textarea>
        </div>
        <div class="ring-panel">
          <div class="ring-panel-head">
            <p id={`${prefix}-result`} class="ring-panel-title">
              Resultado
            </p>
            <button type="button" class="ring-copy" data-ring-copy>
              <svg
                class="ring-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="9" y="9" width="12" height="12" rx="2" />
                <path d="M5 15V5a2 2 0 0 1 2-2h10" />
              </svg>
              Copiar<span class="ring-desktop-only"> resultado</span>
            </button>
          </div>
          <output
            class="ring-output"
            for={`${prefix}-input`}
            aria-labelledby={`${prefix}-result`}
            data-ring-output
          >{initial.output}</output>
          <span class="ring-visually-hidden" role="status" data-ring-copy-status />
        </div>
      </div>

      <div class="ring-details">
        <section class="ring-findings" aria-labelledby={`${prefix}-findings`}>
          <div class="ring-findings-head">
            <h2 id={`${prefix}-findings`} class="ring-findings-title">
              Hallazgos
            </h2>
            <p class="ring-findings-summary" data-ring-summary>
              {summary}
            </p>
          </div>
          <div class="ring-table-box" tabindex="0">
            <table class="ring-table" aria-labelledby={`${prefix}-findings`}>
              <thead>
                <tr>
                  <th scope="col">Tipo</th>
                  <th scope="col">Línea</th>
                  <th scope="col">Resultado</th>
                </tr>
              </thead>
              <tbody data-ring-findings>
                {initial.rows.map((row) => (
                  <tr>
                    <td>{identifierLabel(row.type)}</td>
                    <td>{row.line}</td>
                    <td>{row.result}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <ul
            class="ring-cards"
            aria-labelledby={`${prefix}-findings`}
            data-ring-finding-cards
          >
            {initial.rows.map((row) => (
              <li>
                <span>
                  <span>{identifierLabel(row.type)}</span>
                  <span>Línea {row.line}</span>
                </span>
                <span>{row.result}</span>
              </li>
            ))}
          </ul>
          <p class="ring-note">
            <span class="ring-desktop-only">
              La tabla nunca muestra el valor detectado, igual que
              <code>redact.findings()</code>: solo el tipo, dónde está y qué se
              hizo con él.
            </span>
            <span class="ring-mobile-only">
              Nunca se muestra el valor detectado: solo el tipo, la línea y qué
              se hizo con él.
            </span>
          </p>
        </section>

        <aside class="ring-code ring-desktop-only" aria-labelledby={`${prefix}-code`}>
          <h2 id={`${prefix}-code`} class="ring-code-title">
            Lo mismo en tu código
          </h2>
          <pre class="ring-code-block" tabindex="0"><code data-ring-code>{codeSnippet(DEFAULT_RING_OPTIONS)}</code></pre>
          <p class="ring-demo-key" hidden data-ring-demo-key>
            En el ring, incógnito usa una llave de demostración. En tu
            aplicación usa la tuya, de al menos 32 bytes.
          </p>
        </aside>
        <details class="ring-code ring-mobile-only">
          <summary class="ring-code-title">Lo mismo en tu código</summary>
          <pre class="ring-code-block" tabindex="0"><code data-ring-code>{codeSnippet(DEFAULT_RING_OPTIONS)}</code></pre>
          <p class="ring-demo-key" hidden data-ring-demo-key>
            En el ring, incógnito usa una llave de demostración. En tu
            aplicación usa la tuya, de al menos 32 bytes.
          </p>
        </details>
      </div>
    </section>
  ) : (
    <section
      class="ring ring--compact"
      aria-label="El ring"
      data-ring
      data-ring-hydration={hydration}
      data-ring-variant={variant}
    >
      <div class="ring-compact-panel">
        <label class="ring-panel-title" for={`${prefix}-input`}>Tu log</label>
        <textarea
          id={`${prefix}-input`}
          class="ring-compact-input"
          rows="7"
          spellcheck="false"
          autocomplete="off"
          autocapitalize="off"
          data-ring-input
        >{initialInput}</textarea>
        <fieldset class="ring-group">
          <legend class="ring-visually-hidden">Estrategia</legend>
          <div class="ring-compact-strategies">
            {strategies.map((strategy) => (
              <button
                type="button"
                class="ring-compact-strategy"
                aria-pressed={strategy === DEFAULT_RING_OPTIONS.strategy}
                data-ring-strategy={strategy}
              >
                {strategyLabel(strategy)}
              </button>
            ))}
          </div>
        </fieldset>
      </div>
      <div class="ring-compact-panel">
        <p id={`${prefix}-result`} class="ring-panel-title">Resultado</p>
        <output
          class="ring-compact-output"
          for={`${prefix}-input`}
          aria-labelledby={`${prefix}-result`}
          data-ring-output
        >{initial.output}</output>
        <p class="ring-compact-summary" data-ring-summary>{summary}</p>
      </div>
    </section>
  )
}

<script>
  import '../../ring/dom/ring-island.ts';
</script>

<style>
  .ring {
    font-family: var(--font-body);
  }

  .ring--full {
    display: flex;
    flex-direction: column;
    gap: var(--space-18);
    color: var(--color-paper-200);
  }

  .ring-group {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .ring-overline {
    padding: 0;
    margin-bottom: var(--space-8);
    font-family: var(--font-code);
    font-size: var(--font-size-11);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
    color: var(--color-ink-250);
  }

  .ring-choices {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
  }

  .ring-examples-row {
    flex-wrap: nowrap;
    overflow-x: auto;
    margin: 0 calc(-1 * var(--space-16));
    padding: 0 var(--space-16) var(--space-4);
  }

  .ring-chip {
    flex: 0 0 auto;
    box-sizing: border-box;
    min-height: var(--space-44);
    display: flex;
    align-items: center;
    gap: var(--space-8);
    padding: 0 var(--space-14);
    border: 1px solid var(--color-ink-700);
    border-radius: var(--radius-10);
    background: var(--color-ink-850);
    color: var(--color-paper-200);
    font-family: inherit;
    font-size: var(--font-size-14);
    cursor: pointer;
  }

  .ring-check {
    font-size: var(--font-size-15);
    padding: 0 var(--space-12);
  }

  .ring-check input {
    width: var(--size-icon-18);
    height: var(--size-icon-18);
    margin: 0;
    accent-color: var(--color-pink-500);
  }

  .ring-check:has(input:disabled) {
    cursor: not-allowed;
  }

  .ring-settings-card {
    background: var(--color-ink-900);
    border: 1px solid var(--color-ink-800);
    border-radius: var(--radius-14);
    overflow: hidden;
  }

  .ring-settings-toggle {
    width: 100%;
    min-height: var(--space-56);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-12);
    padding: var(--space-10) var(--space-16);
    border: 0;
    background: transparent;
    color: var(--color-paper-200);
    font-family: inherit;
    text-align: left;
    cursor: pointer;
  }

  .ring-settings-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }

  .ring-settings-title {
    font-weight: var(--font-weight-semibold);
    font-size: var(--font-size-15);
  }

  .ring-settings-summary {
    font-size: var(--font-size-13);
    color: var(--color-ink-250);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ring-chevron {
    flex: 0 0 auto;
    width: var(--size-icon-20);
    height: var(--size-icon-20);
  }

  .ring-settings-toggle[aria-expanded='true'] .ring-chevron {
    transform: rotate(180deg);
  }

  .ring-settings {
    border-top: 1px solid var(--color-ink-800);
    padding: var(--space-16);
    display: flex;
    flex-direction: column;
    gap: var(--space-18);
  }

  .ring-settings[data-collapsed] {
    display: none;
  }

  .ring-strategies {
    order: -1;
  }

  .ring-strategy-list {
    flex-direction: column;
  }

  .ring-types-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .ring-strategy {
    min-height: var(--space-44);
    padding: 0 var(--space-16);
    border: 1px solid var(--color-ink-700);
    border-radius: var(--radius-10);
    background: transparent;
    color: var(--color-paper-200);
    font-family: inherit;
    font-size: var(--font-size-15);
    text-align: left;
    cursor: pointer;
  }

  .ring-strategy[aria-pressed='true'] {
    border-color: var(--color-paper-200);
    background: var(--color-paper-200);
    color: var(--color-ink-950);
    font-weight: var(--font-weight-semibold);
  }

  .ring-panels {
    display: flex;
    flex-direction: column;
    gap: var(--space-18);
  }

  .ring-panel {
    flex: 1 1 var(--width-ring-panel);
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .ring-panel-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-12);
  }

  .ring-panel-title {
    margin: 0;
    font-weight: var(--font-weight-semibold);
    font-size: var(--font-size-15);
  }

  .ring-panel-meta {
    font-family: var(--font-code);
    font-size: var(--font-size-12);
    color: var(--color-ink-250);
  }

  .ring-input,
  .ring-output {
    box-sizing: border-box;
    min-height: var(--height-ring-panel-mobile);
    margin: 0;
    padding: var(--space-14);
    border-radius: var(--radius-12);
    font-family: var(--font-code);
    font-size: var(--font-size-13);
    line-height: var(--line-height-170);
  }

  .ring-input {
    border: 1px solid var(--color-ink-700);
    background: var(--color-ink-900);
    color: var(--color-paper-200);
    resize: vertical;
  }

  .ring-output {
    display: block;
    background: var(--color-paper-200);
    color: var(--color-ink-950);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .ring-copy {
    min-height: var(--space-44);
    display: flex;
    align-items: center;
    gap: var(--space-6);
    padding: 0 var(--space-12);
    border: 1px solid var(--color-ink-700);
    border-radius: var(--radius-10);
    background: transparent;
    color: var(--color-ink-150);
    font-family: inherit;
    font-size: var(--font-size-14);
    cursor: pointer;
  }

  .ring-icon {
    width: var(--size-icon-16);
    height: var(--size-icon-16);
  }

  .ring-details {
    display: flex;
    flex-direction: column;
    gap: var(--space-18);
  }

  .ring-findings {
    flex: 999 1 var(--width-ring-findings);
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .ring-findings-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-8);
  }

  .ring-findings-title {
    margin: 0;
    font-size: var(--font-size-20);
  }

  .ring-findings-summary {
    margin: 0;
    font-size: var(--font-size-13);
    color: var(--color-ink-250);
  }

  .ring-table-box {
    display: none;
    overflow-x: auto;
    border: 1px solid var(--color-ink-800);
    border-radius: var(--radius-14);
  }

  .ring-table {
    width: 100%;
    min-width: var(--width-ring-panel);
    border-collapse: collapse;
    font-size: var(--font-size-15);
  }

  .ring-table thead tr {
    background: var(--color-ink-900);
    text-align: left;
  }

  .ring-table th {
    padding: var(--space-12) var(--space-18);
    font-weight: var(--font-weight-semibold);
  }

  .ring-table :global(td) {
    padding: var(--space-12) var(--space-18);
    border-top: 1px solid var(--color-ink-800);
    font-family: var(--font-code);
    font-size: var(--font-size-14);
  }

  .ring-table :global(td:nth-child(2)) {
    color: var(--color-ink-150);
  }

  .ring-table :global(td:last-child) {
    overflow-wrap: anywhere;
  }

  .ring-table :global(td:last-child)::before,
  .ring-cards :global(li > span:last-child)::before {
    content: '';
    display: inline-block;
    width: var(--size-dot);
    height: var(--size-dot);
    margin-right: var(--space-8);
    border-radius: var(--radius-pill);
    background: var(--color-pink-500);
    vertical-align: middle;
  }

  .ring-cards {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .ring-cards :global(li) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-12);
    padding: var(--space-12) var(--space-14);
    border: 1px solid var(--color-ink-800);
    border-radius: var(--radius-12);
    background: var(--color-ink-900);
  }

  .ring-cards :global(li > span:first-child) {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .ring-cards :global(li > span:first-child > span:first-child) {
    font-family: var(--font-code);
    font-size: var(--font-size-15);
  }

  .ring-cards :global(li > span:first-child > span:last-child) {
    font-size: var(--font-size-13);
    color: var(--color-ink-250);
  }

  .ring-cards :global(li > span:last-child) {
    font-family: var(--font-code);
    font-size: var(--font-size-14);
    overflow-wrap: anywhere;
    text-align: right;
  }

  .ring-note {
    margin: 0;
    font-size: var(--font-size-13);
    line-height: var(--line-height-150);
    color: var(--color-ink-250);
  }

  .ring-note code {
    font-family: var(--font-code);
    font-size: var(--font-size-13);
    color: var(--color-paper-200);
  }

  .ring-code {
    flex: 1 1 var(--width-ring-code);
    min-width: 0;
    background: var(--color-ink-900);
    border: 1px solid var(--color-ink-800);
    border-radius: var(--radius-12);
    overflow: hidden;
  }

  .ring-code-title {
    margin: 0;
    font-size: var(--font-size-15);
    font-weight: var(--font-weight-semibold);
  }

  summary.ring-code-title {
    min-height: var(--space-52);
    display: flex;
    align-items: center;
    padding: 0 var(--space-16);
    cursor: pointer;
  }

  .ring-code-block {
    margin: 0;
    padding: var(--space-14) var(--space-16);
    border-top: 1px solid var(--color-ink-800);
    font-family: var(--font-code);
    font-size: var(--font-size-12-5);
    line-height: var(--line-height-175);
    color: var(--color-paper-200);
    overflow-x: auto;
  }

  .ring-demo-key {
    margin: 0;
    padding: var(--space-12) var(--space-16);
    border-top: 1px solid var(--color-ink-800);
    font-size: var(--font-size-13);
    line-height: var(--line-height-150);
    color: var(--color-gold-300);
  }

  .ring-demo-key[hidden] {
    display: none;
  }

  .ring-desktop-only {
    display: none;
  }

  .ring-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .ring--compact {
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
    color: var(--color-ink-950);
  }

  .ring-compact-panel {
    flex: 1 1 var(--width-ring-compact-panel);
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .ring-compact-input,
  .ring-compact-output {
    box-sizing: border-box;
    margin: 0;
    padding: var(--space-14);
    border-radius: var(--radius-12);
    font-family: var(--font-code);
    font-size: var(--font-size-13);
    line-height: var(--line-height-170);
  }

  .ring-compact-input {
    min-height: var(--height-ring-compact-mobile);
    border: 1px solid var(--color-paper-600);
    background: var(--color-white);
    color: var(--color-ink-950);
    resize: vertical;
  }

  .ring-compact-output {
    display: block;
    min-height: var(--height-ring-compact-mobile);
    background: var(--color-ink-950);
    color: var(--color-paper-200);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .ring-compact-strategies {
    display: flex;
    gap: var(--space-8);
  }

  .ring-compact-strategy {
    flex: 1 1 0;
    min-height: var(--space-44);
    padding: var(--space-10) var(--space-12);
    border: 1px solid var(--color-paper-600);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-ink-950);
    font-family: inherit;
    font-size: var(--font-size-14);
    font-weight: var(--font-weight-medium);
    cursor: pointer;
  }

  .ring-compact-strategy[aria-pressed='true'] {
    border-color: var(--color-ink-950);
    background: var(--color-ink-950);
    color: var(--color-paper-200);
    font-weight: var(--font-weight-semibold);
  }

  .ring-compact-summary {
    margin: 0;
    font-size: var(--font-size-14);
