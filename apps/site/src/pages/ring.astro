---
import '../styles/fonts.css';
import '../styles/tokens.css';
import Ring from '../components/ring/Ring.astro';
import SiteHeader from '../components/SiteHeader.astro';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Pega un log, un JSON o un CSV y mira qué enmascara Enmascara. Todo pasa en tu navegador: nada se envía ni se guarda."
    />
    <title>El ring · Enmascara</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <SiteHeader />
    <main class="ring-page">
      <h1 class="title">El ring</h1>
      <p class="lead">
        Pega un log, un JSON o un CSV y mira qué enmascara Enmascara. Todo pasa
        en tu navegador: nada se envía ni se guarda.
      </p>
      <Ring variant="full" />
    </main>
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    background: var(--color-ink-950);
    color: var(--color-paper-200);
    font-family: var(--font-body);
  }
</style>

<style>
  .ring-page {
    max-width: var(--width-content);
    margin: 0 auto;
    padding: var(--space-40) var(--space-20) var(--space-56);
    display: flex;
    flex-direction: column;
    gap: var(--space-22);
  }

  .title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--font-weight-regular);
    font-size: var(--font-size-52);
    line-height: var(--line-height-098);
    text-transform: uppercase;
  }

  .lead {
    margin: 0;
    max-width: var(--width-lead);
    font-size: var(--font-size-17);
    line-height: var(--line-height-155);
    color: var(--color-ink-150);
  }

  @media (min-width: 48rem) {
    .ring-page {
      padding: var(--space-72) var(--space-32) var(--space-104);
    }

    .title {
      font-size: var(--font-size-88);
      line-height: var(--line-height-095);
      letter-spacing: var(--letter-spacing-narrow);
    }
  }
</style>
