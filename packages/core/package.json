{
  "name": "enmascara",
  "version": "0.1.0",
  "description": "Finds and masks Mexican identifiers validated by their check digit.",
  "keywords": [
    "clabe",
    "curp",
    "rfc",
    "credit-card",
    "mexico",
    "pii",
    "redaction",
    "masking",
    "logging"
  ],
  "license": "MIT",
  "homepage": "https://github.com/finsther/enmascara#readme",
  "bugs": {
    "url": "https://github.com/finsther/enmascara/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finsther/enmascara.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "fast-check": "4.10.2",
    "yaml": "2.9.1"
  }
}
