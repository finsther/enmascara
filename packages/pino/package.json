{
  "name": "enmascara-pino",
  "version": "0.0.0",
  "description": "Masks Mexican identifiers in pino logs with enmascara.",
  "keywords": [
    "pino",
    "logging",
    "clabe",
    "curp",
    "rfc",
    "pii",
    "redaction",
    "masking"
  ],
  "license": "MIT",
  "homepage": "https://github.com/finsther/enmascara/tree/main/packages/pino#readme",
  "bugs": {
    "url": "https://github.com/finsther/enmascara/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finsther/enmascara.git",
    "directory": "packages/pino"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "enmascara": "^0.1.0",
    "pino": "^9.0.0 || ^10.0.0"
  },
  "devDependencies": {
    "enmascara": "workspace:*",
    "pino": "10.4.0",
    "pino-9": "npm:pino@9.14.0"
  }
}
