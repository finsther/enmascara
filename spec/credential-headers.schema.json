{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HTTP headers that carry credentials or sessions",
  "type": "object",
  "additionalProperties": false,
  "required": ["headers"],
  "properties": {
    "headers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "source"],
        "properties": {
          "name": {
            "description": "Header name in lowercase, as Node exposes it.",
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "source": {
            "description": "Specification that defines the header.",
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  }
}
