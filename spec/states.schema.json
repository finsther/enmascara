{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CURP state codes",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "retrieved", "states"],
  "properties": {
    "source": {
      "description": "Official publication the codes were copied from.",
      "type": "string",
      "format": "uri"
    },
    "retrieved": {
      "description": "Date the source was consulted.",
      "type": "string",
      "format": "date"
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "name"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z]{2}$" },
          "name": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
