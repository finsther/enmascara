{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Enmascara text fixtures",
  "description": "Lines of text and the output every implementation must produce with the redact strategy.",
  "type": "object",
  "additionalProperties": false,
  "required": ["cases"],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "input", "output"],
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "input": { "type": "string" },
          "output": {
            "description": "The input with every detected identifier replaced by [TYPE], the type key in upper case.",
            "type": "string"
          }
        }
      }
    }
  }
}
